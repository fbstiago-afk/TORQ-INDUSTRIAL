	/// Alerta 5 (Fornecedor com atraso relevante): desvio normalizado 0–1 em relação ao limite; em branco quando o alerta está inativo.
	measure 'A5 Desvio' =
			VAR _fT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dFornecedor[Fornecedor]), "@v", [Fornecedor no Prazo %]), NOT ISBLANK([@v])), [@v], ASC)
			VAR _fN = MAXX(_fT, dFornecedor[Fornecedor])
			VAR _fV = MAXX(_fT, [@v])
			VAR _meta = [Meta Fornecedor no Prazo]
			RETURN IF(_fV < _meta, MIN(1, DIVIDE(DIVIDE(_meta - _fV, _meta), 0.5)))
		isHidden
		formatString: 0.00
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 3a6efe07-7d60-549a-a4a7-411c60e33aa6

	/// Alerta 5 (Fornecedor com atraso relevante): descrição dinâmica da ocorrência.
	measure 'A5 Texto' =
			VAR _fT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dFornecedor[Fornecedor]), "@v", [Fornecedor no Prazo %]), NOT ISBLANK([@v])), [@v], ASC)
			VAR _fN = MAXX(_fT, dFornecedor[Fornecedor])
			VAR _fV = MAXX(_fT, [@v])
			VAR _a = CALCULATE([Atraso Médio Fornecedor (dias)], dFornecedor[Fornecedor] = _fN)
			VAR _lt = CALCULATE([Lead Time Real (dias)], dFornecedor[Fornecedor] = _fN)
			RETURN _fN & ": só " & FORMAT(_fV, "0.0%", "pt-BR") & " no prazo, atraso médio de " & FORMAT(_a, "0.0", "pt-BR") & " d e lead time de " & FORMAT(_lt, "0.0", "pt-BR") & " d."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 99b62fef-58c9-503c-9734-1cd60efd2a93

	/// Alerta 5 (Fornecedor com atraso relevante): ação sugerida.
