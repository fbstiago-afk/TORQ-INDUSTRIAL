	/// Alerta 3 (Scrap acima do limite): descrição dinâmica da ocorrência.
	measure 'A3 Texto' =
			VAR _fT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dFornecedor[Fornecedor]), "@v", [Scrap %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _fN = MAXX(_fT, dFornecedor[Fornecedor])
			VAR _fV = MAXX(_fT, [@v])
			VAR _c = CALCULATE([Custo Refugo], dFornecedor[Fornecedor] = _fN)
			RETURN "Scrap de " & FORMAT(_fV, "0.00%", "pt-BR") & " nas OPs abastecidas por " & _fN & " (" & IF(ABS(_c) >= 1000000, "R$ " & FORMAT(DIVIDE(_c, 1000000), "0.00", "pt-BR") & " Mi", "R$ " & FORMAT(DIVIDE(_c, 1000), "#,0", "pt-BR") & " mil") & " em refugo)."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 571e4c23-dd90-565d-b82d-f19109739aef

	/// Alerta 3 (Scrap acima do limite): ação sugerida.
	measure 'A3 Ação' =
			VAR _fT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dFornecedor[Fornecedor]), "@v", [Scrap %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _fN = MAXX(_fT, dFornecedor[Fornecedor])
			VAR _fV = MAXX(_fT, [@v])
			VAR _c = CALCULATE([Principal Causa Defeito], dFornecedor[Fornecedor] = _fN)
			RETURN "Defeito dominante: " & _c & ". Auditar o lote de MP e a inspeção de recebimento."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: c55f5ad1-5187-5b81-8ede-813b632f40d8

	/// Alerta 4 (MP abaixo do estoque de segurança): desvio normalizado 0–1 em relação ao limite; em branco quando o alerta está inativo.
	measure 'A4 Desvio' =
			VAR _xT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dMateriaPrima[Matéria-Prima]), "@v", [OPs Abaixo da Segurança %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _xN = MAXX(_xT, dMateriaPrima[Matéria-Prima])
