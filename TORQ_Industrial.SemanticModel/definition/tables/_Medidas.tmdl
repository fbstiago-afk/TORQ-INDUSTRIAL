			VAR _mes = DATE(YEAR(_ult), MONTH(_ult), 1)
			VAR _cur = CALCULATE([Custo Total], dCalendario[Início Mês] = _mes)
			VAR _ant = CALCULATE([Custo Total], REMOVEFILTERS(dCalendario), dCalendario[Início Mês] = EDATE(_mes, -1))
			RETURN IF(NOT ISBLANK(_cur) && NOT ISBLANK(_ant), DIVIDE(_cur - _ant, _ant))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10 | Comparativos
		lineageTag: 5244dfc2-c0e4-5481-a211-d17c5e591973

	/// Fornecedor no Prazo %: último mês do contexto versus o mês anterior (em pontos percentuais).
	measure 'Fornecedor no Prazo % Δ Mês' =
			VAR _ult = MAX(fProducao[Data])
			VAR _mes = DATE(YEAR(_ult), MONTH(_ult), 1)
			VAR _cur = CALCULATE([Fornecedor no Prazo %], dCalendario[Início Mês] = _mes)
			VAR _ant = CALCULATE([Fornecedor no Prazo %], REMOVEFILTERS(dCalendario), dCalendario[Início Mês] = EDATE(_mes, -1))
			RETURN IF(NOT ISBLANK(_cur) && NOT ISBLANK(_ant), (_cur - _ant) * 100)
		formatString: +0.0;-0.0;0.0
		displayFolder: 10 | Comparativos
		lineageTag: e3f5d621-0b42-5235-8906-2ba6552f4ec5

	/// Lead Time Real (dias): último mês do contexto versus o mês anterior (diferença absoluta).
	measure 'Lead Time Real (dias) Δ Mês' =
			VAR _ult = MAX(fProducao[Data])
			VAR _mes = DATE(YEAR(_ult), MONTH(_ult), 1)
			VAR _cur = CALCULATE([Lead Time Real (dias)], dCalendario[Início Mês] = _mes)
			VAR _ant = CALCULATE([Lead Time Real (dias)], REMOVEFILTERS(dCalendario), dCalendario[Início Mês] = EDATE(_mes, -1))
			RETURN IF(NOT ISBLANK(_cur) && NOT ISBLANK(_ant), _cur - _ant)
		formatString: +0.0;-0.0;0.0
		displayFolder: 10 | Comparativos
		lineageTag: f5f417b2-0617-5b4a-bc6f-d7122ce68cc3

	/// Reprovação MP %: último mês do contexto versus o mês anterior (em pontos percentuais).
	measure 'Reprovação MP % Δ Mês' =
			VAR _ult = MAX(fProducao[Data])
			VAR _mes = DATE(YEAR(_ult), MONTH(_ult), 1)
			VAR _cur = CALCULATE([Reprovação MP %], dCalendario[Início Mês] = _mes)
			VAR _ant = CALCULATE([Reprovação MP %], REMOVEFILTERS(dCalendario), dCalendario[Início Mês] = EDATE(_mes, -1))
			RETURN IF(NOT ISBLANK(_cur) && NOT ISBLANK(_ant), (_cur - _ant) * 100)
		formatString: +0.0;-0.0;0.0
		displayFolder: 10 | Comparativos
		lineageTag: 664e84e7-f17a-5d7a-a600-128cca09bda5

	/// Rupturas: último mês do contexto versus o mês anterior (diferença absoluta).
	measure 'Rupturas Δ Mês' =
			VAR _ult = MAX(fProducao[Data])
			VAR _mes = DATE(YEAR(_ult), MONTH(_ult), 1)
			VAR _cur = CALCULATE([Rupturas], dCalendario[Início Mês] = _mes)
			VAR _ant = CALCULATE([Rupturas], REMOVEFILTERS(dCalendario), dCalendario[Início Mês] = EDATE(_mes, -1))
			RETURN IF(NOT ISBLANK(_cur) && NOT ISBLANK(_ant), _cur - _ant)
		formatString: +0.0;-0.0;0.0
		displayFolder: 10 | Comparativos
		lineageTag: cf675ee4-e7ab-5e1e-8f3e-85f266e94793

	/// Frete por Unidade: último mês do contexto versus o mês anterior (variação relativa).
	measure 'Frete por Unidade Δ Mês' =
			VAR _ult = MAX(fProducao[Data])
			VAR _mes = DATE(YEAR(_ult), MONTH(_ult), 1)
			VAR _cur = CALCULATE([Frete por Unidade], dCalendario[Início Mês] = _mes)
			VAR _ant = CALCULATE([Frete por Unidade], REMOVEFILTERS(dCalendario), dCalendario[Início Mês] = EDATE(_mes, -1))
			RETURN IF(NOT ISBLANK(_cur) && NOT ISBLANK(_ant), DIVIDE(_cur - _ant, _ant))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10 | Comparativos
		lineageTag: 4c204f29-3983-50d6-a46a-5c6953f8018e

	/// Percentual de redução de downtime escolhido no simulador (padrão 10%).
	measure 'Sim Redução Downtime' = SELECTEDVALUE('Simulação Downtime'[Redução Downtime], 0.10)
		formatString: 0%
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 375de888-83b2-5a9c-ac45-87f6b0d7de65

	/// SIMULAÇÃO: horas de parada recuperadas = Horas Parada × redução escolhida.
	measure 'Sim Horas Recuperadas' = [Horas Parada] * [Sim Redução Downtime]
		formatString: #,0.0
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 98b38963-5493-5356-bb49-55853dd95b75

	/// SIMULAÇÃO: produção adicional estimada = horas recuperadas × produção por hora operando atual (mantém a performance observada).
	measure 'Sim Produção Adicional' = [Sim Horas Recuperadas] * [Produção por Hora]
		formatString: #,0
		displayFolder: 11 | Simulação (What-if)
		lineageTag: fcacf818-8d30-549d-a461-9b0f38b0c443

	/// SIMULAÇÃO: OEE com a disponibilidade recalculada após a redução de downtime (performance e qualidade mantidas).
	measure 'Sim OEE Projetado' = DIVIDE([Horas Operando] + [Sim Horas Recuperadas], [Horas Planejadas]) * [Performance %] * [Qualidade %]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 8c392800-510e-557c-abdc-40cc14c8a211

	/// SIMULAÇÃO: ganho de OEE em pontos percentuais.
	measure 'Sim Ganho OEE p.p.' = ([Sim OEE Projetado] - [OEE %]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 11 | Simulação (What-if)
		lineageTag: c36f4bce-8184-5ec4-bdd6-842aac85a75f

	/// SIMULAÇÃO: aderência ao plano somando a produção adicional estimada.
	measure 'Sim Aderência Projetada' = DIVIDE([Produção Real] + [Sim Produção Adicional], [Plano])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 8011d8cf-d072-5855-a1e6-ed52984bd8bd

	/// Percentual de redução de scrap escolhido no simulador (padrão 20%).
	measure 'Sim Redução Scrap' = SELECTEDVALUE('Simulação Scrap'[Redução Scrap], 0.20)
		formatString: 0%
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 4034f4da-a90a-5963-b3b3-7ae40ca9c7ba

	/// SIMULAÇÃO: unidades que deixariam de ser refugadas = Refugo × redução escolhida.
	measure 'Sim Unidades Recuperadas' = [Refugo] * [Sim Redução Scrap]
		formatString: #,0
		displayFolder: 11 | Simulação (What-if)
		lineageTag: dd6bbf0c-2830-5f23-b727-7b30ab1d24ae

	/// SIMULAÇÃO: redução do custo de refugo = Custo Refugo × redução escolhida.
	measure 'Sim Economia CNQ' = [Custo Refugo] * [Sim Redução Scrap]
		formatString: \R$ #,0
		displayFolder: 11 | Simulação (What-if)
		lineageTag: e8e0462e-064d-5b35-beed-426b4480b717

	/// SIMULAÇÃO: custo por unidade boa após a redução de scrap = (Custo Total − economia) / (Produção Boa + unidades recuperadas).
	measure 'Sim Custo por Unidade Boa' = DIVIDE([Custo Total] - [Sim Economia CNQ], [Produção Boa] + [Sim Unidades Recuperadas])
		formatString: \R$ #,0.00
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 4c8958a7-affc-5e30-9f51-935cd443f610

	/// Título dinâmico do simulador de downtime.
	measure 'Sim Título Downtime' = "SIMULAÇÃO · Se o downtime cair " & FORMAT([Sim Redução Downtime], "0%", "pt-BR") & ": +" & FORMAT([Sim Produção Adicional], "#,0", "pt-BR") & " un. e OEE de " & FORMAT([Sim OEE Projetado], "0.0%", "pt-BR")
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 949aa625-35ce-56a9-b9de-49d5f4aaf88b

	/// Título dinâmico do simulador de scrap.
	measure 'Sim Título Scrap' = "SIMULAÇÃO · Se o scrap cair " & FORMAT([Sim Redução Scrap], "0%", "pt-BR") & ": economia de " & IF(ABS([Sim Economia CNQ]) >= 1000000, "R$ " & FORMAT(DIVIDE([Sim Economia CNQ], 1000000), "0.00", "pt-BR") & " Mi", "R$ " & FORMAT(DIVIDE([Sim Economia CNQ], 1000), "#,0", "pt-BR") & " mil")
		displayFolder: 11 | Simulação (What-if)
		lineageTag: 232fdc36-0e1b-5d14-b140-8ec9df02e461

	/// Alerta 1 (OEE abaixo da meta): desvio normalizado 0–1 em relação ao limite; em branco quando o alerta está inativo.
	measure 'A1 Desvio' =
			VAR _gap = DIVIDE([Meta OEE] - [OEE %], [Meta OEE])
			RETURN IF(NOT ISBLANK([OEE %]) && _gap > 0, MIN(1, DIVIDE(_gap, 0.20)))
		isHidden
		formatString: 0.00
		displayFolder: 12 | Alertas\Componentes
		lineageTag: a4233a28-24bd-53d8-9e09-ce3b256bbfee

	/// Alerta 1 (OEE abaixo da meta): descrição dinâmica da ocorrência.
	measure 'A1 Texto' =
			VAR _lT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dLinha[Linha]), "@v", [OEE %]), NOT ISBLANK([@v])), [@v], ASC)
			VAR _lN = MAXX(_lT, dLinha[Linha])
			VAR _lV = MAXX(_lT, [@v])
			RETURN "OEE em " & FORMAT([OEE %], "0.0%", "pt-BR") & ", " & FORMAT(-[OEE Gap Meta p.p.], "0.0", "pt-BR") & " p.p. abaixo da meta. Pior linha: " & _lN & " (" & FORMAT(_lV, "0.0%", "pt-BR") & ")."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 23f28d00-721c-572f-86e4-17021e10686e

	/// Alerta 1 (OEE abaixo da meta): ação sugerida.
	measure 'A1 Ação' = "Atacar a perda de " & [OEE Maior Perda] & " (" & FORMAT(SWITCH([OEE Maior Perda], "Disponibilidade", [Disponibilidade %], "Performance", [Performance %], [Qualidade %]), "0.0%", "pt-BR") & ")."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: e0a2374a-a936-5bba-b79f-6b2d537e06d5

	/// Alerta 2 (Downtime elevado): desvio normalizado 0–1 em relação ao limite; em branco quando o alerta está inativo.
	measure 'A2 Desvio' =
			VAR _lT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dLinha[Linha]), "@v", [Downtime %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _lN = MAXX(_lT, dLinha[Linha])
			VAR _lV = MAXX(_lT, [@v])
			VAR _lim = [Limite Downtime]
			RETURN IF(_lV > _lim, MIN(1, DIVIDE(DIVIDE(_lV - _lim, _lim), 0.5)))
		isHidden
		formatString: 0.00
		displayFolder: 12 | Alertas\Componentes
		lineageTag: a3322bfe-85ff-5a49-b29c-72b14a0d87fe

	/// Alerta 2 (Downtime elevado): descrição dinâmica da ocorrência.
	measure 'A2 Texto' =
			VAR _lT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dLinha[Linha]), "@v", [Downtime %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _lN = MAXX(_lT, dLinha[Linha])
			VAR _lV = MAXX(_lT, [@v])
			VAR _h = CALCULATE([Horas Parada], dLinha[Linha] = _lN)
			VAR _u = CALCULATE([Impacto Downtime un. (est.)], dLinha[Linha] = _lN)
			RETURN _lN & " com " & FORMAT(_lV, "0.0%", "pt-BR") & " de downtime (" & FORMAT(_h, "#,0", "pt-BR") & " h ≈ " & FORMAT(_u, "#,0", "pt-BR") & " un. estimadas)."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 8e9ed1ad-7bb6-5a84-bccc-0b01ee7f524e

	/// Alerta 2 (Downtime elevado): ação sugerida.
	measure 'A2 Ação' =
			VAR _lT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dLinha[Linha]), "@v", [Downtime %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _lN = MAXX(_lT, dLinha[Linha])
			VAR _lV = MAXX(_lT, [@v])
			VAR _c = CALCULATE([Principal Causa Parada], dLinha[Linha] = _lN)
			RETURN "Causa principal: " & _c & ". Priorizar plano de manutenção/setup da linha."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: bd4611b0-f021-5219-a2bb-6be0a0233f93

	/// Alerta 3 (Scrap acima do limite): desvio normalizado 0–1 em relação ao limite; em branco quando o alerta está inativo.
	measure 'A3 Desvio' =
			VAR _fT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dFornecedor[Fornecedor]), "@v", [Scrap %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _fN = MAXX(_fT, dFornecedor[Fornecedor])
			VAR _fV = MAXX(_fT, [@v])
			VAR _lim = [Limite Scrap]
			RETURN IF(_fV > _lim, MIN(1, DIVIDE(DIVIDE(_fV - _lim, _lim), 0.5)))
