/// Tabela exclusiva de medidas, organizada em pastas.
table _Medidas
	lineageTag: 9504f70e-5663-5b1f-9ab0-170c37ca9931

	/// Meta gerencial de OEE (85%). Parâmetro de gestão, não é dado observado na base.
	measure 'Meta OEE' = 0.85
		formatString: 0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: f242e00d-c454-5812-961e-fd3866eb03f5

	/// Meta gerencial de aderência ao plano (98%). Parâmetro de gestão.
	measure 'Meta Aderência' = 0.98
		formatString: 0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: 0f7cbf0b-476e-5a25-b6c0-3560d49542b7

	/// Meta gerencial de OTIF ao cliente (90%). Parâmetro de gestão.
	measure 'Meta OTIF' = 0.90
		formatString: 0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: a7c876d3-4f39-5cf0-b507-4231b40ae86f

	/// Meta gerencial de pontualidade de fornecedores (80%). Parâmetro de gestão.
	measure 'Meta Fornecedor no Prazo' = 0.80
		formatString: 0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: 03bd9a63-2ab3-5f2b-bf66-1f3e322e358d

	/// Limite gerencial de scrap (0,8% da produção). Parâmetro de gestão.
	measure 'Limite Scrap' = 0.008
		formatString: 0.0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: 002adffd-9b59-5d71-92b5-92bfbdbb9a1d

	/// Limite gerencial de downtime (15% das horas planejadas). Parâmetro de gestão.
	measure 'Limite Downtime' = 0.15
		formatString: 0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: d103af45-a09a-5b95-a21e-f46d46efb9db

	/// Limite gerencial do custo da não qualidade (0,70% do custo total). Parâmetro de gestão.
	measure 'Limite CNQ' = 0.007
		formatString: 0.00%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: 9ffb2789-5875-5335-b751-a461a124bf6f

	/// Limite gerencial de reprovação de matéria-prima no recebimento (2%).
	measure 'Limite Reprovação MP' = 0.02
		formatString: 0.0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: 2cc4075a-3ad8-50be-bcd7-30878c3db6a5

	/// Limite gerencial: % de OPs com estoque final de MP abaixo do estoque de segurança (10%).
	measure 'Limite OPs Abaixo Segurança' = 0.10
		formatString: 0%
		displayFolder: 00 | Metas e Limites (parâmetros gerenciais)
		lineageTag: d14cb3f6-fec7-51e3-b5d8-7d61fb69c505

	/// Quantidade total produzida (boa + refugo) nas ordens de produção.
	measure 'Produção Real' = SUM(fProducao[Qtd Produzida])
		formatString: #,0
		displayFolder: 01 | Produção
		lineageTag: 7a7631b3-156e-5d22-8016-738f6e62d8a1

	/// Quantidade produzida aprovada (sem refugo).
	measure 'Produção Boa' = SUM(fProducao[Qtd Boa])
		formatString: #,0
		displayFolder: 01 | Produção
		lineageTag: ab8a75c5-2307-564e-bf06-eda3506a1012

	/// Quantidade planejada/demandada nas ordens de produção (demanda_qtd).
	measure Plano = SUM(fProducao[Demanda Qtd])
		formatString: #,0
		displayFolder: 01 | Produção
		lineageTag: 20fd4d19-b94e-5b44-a34c-16d40d451917

	/// Produção Real menos Plano. Negativo = produção abaixo do plano.
	measure 'Gap Produção' = [Produção Real] - [Plano]
		formatString: +#,0;-#,0;0
		displayFolder: 01 | Produção
		lineageTag: e5cd2907-f402-5032-8927-c8cf9ee28389

	/// Produção Real dividida pelo Plano.
	measure 'Aderência ao Plano %' = DIVIDE([Produção Real], [Plano])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 | Produção
		lineageTag: 129a0037-b6df-52ee-814b-14a01ef71947

	/// Produção Boa dividida pelo Plano: quanto da demanda foi atendido com produto aprovado.
	measure 'Atendimento Produto Bom %' = DIVIDE([Produção Boa], [Plano])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 | Produção
		lineageTag: 3a1c51ad-76c6-5c81-a056-15a53641f2ac

	/// Número de ordens de produção.
	measure 'Nº OPs' = COUNTROWS(fProducao)
		formatString: #,0
		displayFolder: 01 | Produção
		lineageTag: 8ba3665c-dee2-5a9a-a477-bfaa72dc814f

	/// Percentual de ordens com status Parcial.
	measure 'OPs Parciais %' = DIVIDE(CALCULATE(COUNTROWS(fProducao), fProducao[Status OP] = "Parcial"), [Nº OPs])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 | Produção
		lineageTag: 4dfd3293-53e9-5e69-857e-12cf9947b51b

	/// Unidades produzidas por hora operando.
	measure 'Produção por Hora' = DIVIDE([Produção Real], [Horas Operando])
		formatString: #,0.0
		displayFolder: 01 | Produção
		lineageTag: 658036c3-4256-5c86-ba13-d0e410ce0996

	/// Média móvel de 3 meses da produção real (linha de tendência; não é previsão).
	measure 'Produção Média Móvel 3M' =
			VAR _fim = MAX(dCalendario[Data])
			VAR _p = DATESINPERIOD(dCalendario[Data], _fim, -3, MONTH)
			VAR _n = CALCULATE(DISTINCTCOUNT(dCalendario[Início Mês]), _p)
			RETURN IF(NOT ISBLANK([Produção Real]), DIVIDE(CALCULATE([Produção Real], _p), _n))
		formatString: #,0
		displayFolder: 01 | Produção
		lineageTag: 1c126cf2-0bca-55f5-b04f-695acf9e8518

	/// Horas planejadas de operação.
	measure 'Horas Planejadas' = SUM(fProducao[Horas Planejadas])
		formatString: #,0.0
		displayFolder: 02 | Eficiência
		lineageTag: d6e07618-1928-5547-87bf-c8575889a7ce

	/// Horas efetivamente operando.
	measure 'Horas Operando' = SUM(fProducao[Horas Operando])
		formatString: #,0.0
		displayFolder: 02 | Eficiência
		lineageTag: 9798bc95-a981-594b-8c11-f3b5c50f7d06

	/// Horas operando ponderadas pela performance da OP (horas equivalentes no ritmo padrão). Base aditiva para agregar a Performance.
	measure 'Horas Ritmo Padrão' = SUM(fProducao[Horas Ritmo Padrão])
		isHidden
		formatString: #,0.0
		displayFolder: 02 | Eficiência
		lineageTag: 76fae7b2-09b1-525d-9a4e-1f688859e969

	/// Horas Operando / Horas Planejadas. Equivale à utilização do tempo planejado.
	measure 'Disponibilidade %' = DIVIDE([Horas Operando], [Horas Planejadas])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 | Eficiência
		lineageTag: a770a08c-0d40-500f-9067-b84d1db18f94

	/// Performance agregada: média da performance das OPs ponderada pelas horas operando.
	measure 'Performance %' = DIVIDE([Horas Ritmo Padrão], [Horas Operando])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 | Eficiência
		lineageTag: 939dbe5c-2547-5d03-942a-29cf7ee040f2

	/// Produção Boa / Produção Real (Yield).
	measure 'Qualidade %' = DIVIDE([Produção Boa], [Produção Real])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 | Eficiência
		lineageTag: adeb48c1-2227-5bdc-983a-f3fe3c57f0d2

	/// OEE = Disponibilidade × Performance × Qualidade, recalculado no nível de agregação do contexto.
	measure 'OEE %' = [Disponibilidade %] * [Performance %] * [Qualidade %]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 | Eficiência
		lineageTag: 2fc61b59-3b25-5b75-9b0a-7d771b3d03f0

	/// Diferença em pontos percentuais entre o OEE e a meta.
	measure 'OEE Gap Meta p.p.' = ([OEE %] - [Meta OEE]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 02 | Eficiência
		lineageTag: 81959949-6fa1-5c1d-8e4e-076675244878

	/// Classificação do OEE: Na meta (≥ meta), Atenção (até 10 p.p. abaixo) ou Crítico.
	measure 'OEE Classificação' =
			VAR _v = [OEE %]
			RETURN SWITCH(TRUE(), ISBLANK(_v), BLANK(), _v >= [Meta OEE], "● Na meta", _v >= [Meta OEE] - 0.10, "● Atenção", "● Crítico")
		displayFolder: 02 | Eficiência
		lineageTag: 1b69048e-8c0f-500a-bf9d-3e1fcde511ef

	/// Componente do OEE com o menor índice (onde está a maior perda).
	measure 'OEE Maior Perda' =
			VAR _d = [Disponibilidade %]
			VAR _p = [Performance %]
			VAR _q = [Qualidade %]
			VAR _min = MIN(_d, MIN(_p, _q))
			RETURN SWITCH(TRUE(), ISBLANK(_d), BLANK(), _min = _d, "Disponibilidade", _min = _p, "Performance", "Qualidade")
		displayFolder: 02 | Eficiência
		lineageTag: 6adc9db1-f6b0-54d7-8305-eba54561593d

	/// Unidades por hora em ritmo padrão (Produção Real / Horas Ritmo Padrão). Usada para converter horas perdidas em unidades estimadas.
	measure 'Taxa Padrão un/h' = DIVIDE([Produção Real], [Horas Ritmo Padrão])
		isHidden
		formatString: #,0.0
		displayFolder: 02 | Eficiência
		lineageTag: 79b3bdb7-c590-5c5e-912a-264fc69ce327

	/// Quantidade refugada (scrap).
	measure Refugo = SUM(fProducao[Qtd Refugo])
		formatString: #,0
		displayFolder: 03 | Qualidade
		lineageTag: 8dd239a1-17ba-5500-8a62-c8dd338189de

	/// Refugo / Produção Real.
	measure 'Scrap %' = DIVIDE([Refugo], [Produção Real])
		formatString: 0.00%
		displayFolder: 03 | Qualidade
		lineageTag: f38a8055-b6d3-5767-a5ba-5a8a56139bc3

	/// Quantidade retrabalhada.
	measure Retrabalho = SUM(fProducao[Qtd Retrabalho])
		formatString: #,0
		displayFolder: 03 | Qualidade
		lineageTag: 88dd3b97-8b18-5349-addf-a7c7f6e7a64a

	/// Retrabalho / Produção Real.
	measure 'Retrabalho %' = DIVIDE([Retrabalho], [Produção Real])
		formatString: 0.00%
		displayFolder: 03 | Qualidade
		lineageTag: f6cf647b-e49d-5847-8b39-335a9912159b

	/// Rendimento: Produção Boa / Produção Real.
	measure 'Yield %' = [Qualidade %]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 | Qualidade
		lineageTag: 897c4958-c84d-5569-8eb8-d6aa20e30d98

	/// First Pass Yield aproximado: (Produção Boa − Retrabalho) / Produção Real. Assume que as unidades retrabalhadas estão contidas na produção boa.
	measure 'FPY % (aprox.)' = DIVIDE([Produção Boa] - [Retrabalho], [Produção Real])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 | Qualidade
		lineageTag: 21ec325d-47e9-521f-ac3e-d7d330b04947

	/// (Refugo + Retrabalho) / Produção Real.
	measure 'Taxa de Defeitos %' = DIVIDE([Refugo] + [Retrabalho], [Produção Real])
		formatString: 0.00%
		displayFolder: 03 | Qualidade
		lineageTag: b655f213-1098-5019-aea5-7bc9252ce5f1

	/// Custo das unidades refugadas.
	measure 'Custo Refugo' = SUM(fProducao[Custo Refugo])
		formatString: \R$ #,0
		displayFolder: 03 | Qualidade
		lineageTag: f0d0a5fa-470a-5047-8e46-4477e9b46ea5

	/// Custo do retrabalho.
	measure 'Custo Retrabalho' = SUM(fProducao[Custo Retrabalho])
		formatString: \R$ #,0
		displayFolder: 03 | Qualidade
		lineageTag: c0a43398-7126-5641-ae4f-88ff7d900590

	/// CNQ = Custo de Refugo + Custo de Retrabalho.
	measure 'Custo Não Qualidade' = [Custo Refugo] + [Custo Retrabalho]
		formatString: \R$ #,0
		displayFolder: 03 | Qualidade
		lineageTag: 539576ce-9861-5273-b627-c62142590c4e

	/// Custo da Não Qualidade / Custo Total.
	measure 'CNQ % do Custo' = DIVIDE([Custo Não Qualidade], [Custo Total])
		formatString: 0.00%
		displayFolder: 03 | Qualidade
		lineageTag: 47e33d6f-46f1-57d6-8efb-4fa99ac3127d

	/// CNQ apenas das OPs com causa de defeito relevante (exclui 'Sem defeito relevante'). Base do Pareto e do heatmap.
	measure 'CNQ Defeitos' = CALCULATE([Custo Não Qualidade], KEEPFILTERS(dCausaDefeito[Relevante] = 1))
		formatString: \R$ #,0
		displayFolder: 03 | Qualidade
		lineageTag: 1fe15caa-e85b-5ee6-a1ae-69a51a330052

	/// Percentual acumulado do CNQ por causa de defeito (ordem decrescente).
	measure 'Pareto Defeitos % Acum.' =
			VAR _atual = [CNQ Defeitos]
			VAR _t = CALCULATETABLE(ADDCOLUMNS(VALUES(dCausaDefeito[Causa Defeito]), "@v", [CNQ Defeitos]), ALLSELECTED(dCausaDefeito))
			VAR _total = SUMX(_t, [@v])
			VAR _acum = SUMX(FILTER(_t, [@v] >= _atual), [@v])
			RETURN IF(_atual > 0, DIVIDE(_acum, _total))
		formatString: 0%
		displayFolder: 03 | Qualidade
		lineageTag: 08bf758b-7e7f-5a28-bd69-af862bbe078e

	/// Causa de defeito relevante com maior custo da não qualidade no contexto.
	measure 'Principal Causa Defeito' =
			VAR _cT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dCausaDefeito[Causa Defeito]), "@v", [CNQ Defeitos]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _cN = MAXX(_cT, dCausaDefeito[Causa Defeito])
			VAR _cV = MAXX(_cT, [@v])
			RETURN _cN
		displayFolder: 03 | Qualidade
		lineageTag: b83d901a-21d9-54cd-ad98-5d278fe71686

	/// Horas de parada (Horas Planejadas − Horas Operando).
	measure 'Horas Parada' = SUM(fProducao[Horas Parada])
		formatString: #,0.0
		displayFolder: 04 | Downtime
		lineageTag: b5c63895-5b59-5391-9b25-d77af3e8e7c2

	/// Horas Parada / Horas Planejadas.
	measure 'Downtime %' = DIVIDE([Horas Parada], [Horas Planejadas])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 | Downtime
		lineageTag: 65dbd2c1-3747-5365-889b-ffc77ad8f1f6

	/// Horas de parada por setup/troca.
	measure 'Horas Setup' = SUM(fProducao[Horas Setup])
		formatString: #,0.0
		displayFolder: 04 | Downtime
		lineageTag: b48bd2d8-f0e6-5158-b376-a80cdcb02b21

	/// Horas de parada por manutenção.
	measure 'Horas Manutenção' = SUM(fProducao[Horas Manutenção])
		formatString: #,0.0
		displayFolder: 04 | Downtime
		lineageTag: a4f427a6-df5e-55d6-b4c0-aadfe0c4e70d

	/// Horas de parada por falta de material.
	measure 'Horas Falta Material' = SUM(fProducao[Horas Falta Material])
		formatString: #,0.0
		displayFolder: 04 | Downtime
		lineageTag: ecbfa250-ac6c-5180-a36a-6eb0ac643db9

	/// Horas de parada das OPs com causa principal relevante (exclui 'Sem parada relevante'). Base do Pareto.
	measure 'Paradas Pareto h' = CALCULATE([Horas Parada], KEEPFILTERS(dCausaParada[Relevante] = 1))
		formatString: #,0.0
		displayFolder: 04 | Downtime
		lineageTag: 51617594-c49f-5f1c-80d5-aa2668942edd

	/// Percentual acumulado das horas de parada por causa principal (ordem decrescente).
	measure 'Pareto Paradas % Acum.' =
			VAR _atual = [Paradas Pareto h]
			VAR _t = CALCULATETABLE(ADDCOLUMNS(VALUES(dCausaParada[Causa Parada]), "@v", [Paradas Pareto h]), ALLSELECTED(dCausaParada))
			VAR _total = SUMX(_t, [@v])
			VAR _acum = SUMX(FILTER(_t, [@v] >= _atual), [@v])
			RETURN IF(_atual > 0, DIVIDE(_acum, _total))
		formatString: 0%
		displayFolder: 04 | Downtime
		lineageTag: 7aff4e19-7b88-5442-bf52-aeeefac5b1de

	/// Linha de referência de 80% para os gráficos de Pareto.
	measure 'Referência 80%' = 0.8
		formatString: 0%
		displayFolder: 04 | Downtime
		lineageTag: 8057298c-f8b2-5867-a67f-b23a82902935

	/// Causa principal de parada com mais horas no contexto.
	measure 'Principal Causa Parada' =
			VAR _cT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dCausaParada[Causa Parada]), "@v", [Paradas Pareto h]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _cN = MAXX(_cT, dCausaParada[Causa Parada])
			VAR _cV = MAXX(_cT, [@v])
			RETURN _cN
		displayFolder: 04 | Downtime
		lineageTag: d52699ea-e3ed-5e60-a1ef-956a72aa8313

	/// ESTIMATIVA: unidades não produzidas devido às paradas = Horas Parada × Taxa Padrão (un/h).
	measure 'Impacto Downtime un. (est.)' = [Horas Parada] * [Taxa Padrão un/h]
		formatString: #,0
		displayFolder: 04 | Downtime
		lineageTag: 0da0900a-3982-5d31-a547-5248a746001f

	/// ESTIMATIVA: produção possível se todas as horas planejadas fossem operadas no ritmo padrão = Horas Planejadas × Taxa Padrão.
	measure 'Capacidade Teórica un. (est.)' = [Horas Planejadas] * [Taxa Padrão un/h]
		formatString: #,0
		displayFolder: 04 | Downtime
		lineageTag: b42f1fe0-9260-5c9b-84f0-e952a7e9de6e

	/// ESTIMATIVA: unidades perdidas por operar abaixo do ritmo padrão = (Horas Operando − Horas Ritmo Padrão) × Taxa Padrão.
	measure 'Perda Ritmo un. (est.)' = ([Horas Operando] - [Horas Ritmo Padrão]) * [Taxa Padrão un/h]
		formatString: #,0
		displayFolder: 04 | Downtime
		lineageTag: ac322fcd-83da-55c6-8cf6-6a3ece427f57

	/// Valor de cada etapa da ponte Capacidade Teórica → Produção Boa (unidades estimadas pelas horas perdidas × taxa padrão).
	measure 'Ponte de Perdas un.' =
			VAR _tx = [Taxa Padrão un/h]
			RETURN SWITCH(SELECTEDVALUE(Ponte[Ordem]),
			    1, [Capacidade Teórica un. (est.)],
			    2, - [Horas Setup] * _tx,
			    3, - [Horas Manutenção] * _tx,
			    4, - [Horas Falta Material] * _tx,
			    5, - [Perda Ritmo un. (est.)],
			    6, - [Refugo]
			)
		formatString: #,0
		displayFolder: 04 | Downtime
		lineageTag: f276422a-4dff-5675-a407-ea01d8a45c4b

	/// Custo total das ordens de produção (matéria-prima + mão de obra + energia + refugo + retrabalho).
	measure 'Custo Total' = SUM(fProducao[Custo Total OP])
		formatString: \R$ #,0
		displayFolder: 05 | Custos
		lineageTag: f71ea56b-73f7-5f6e-a8c8-0fc1a64cb737

	/// Custo de matéria-prima (custo unitário × quantidade produzida).
	measure 'Custo Matéria-Prima' = SUM(fProducao[Custo MP])
		formatString: \R$ #,0
		displayFolder: 05 | Custos
		lineageTag: 236a0d0e-8da2-5bf6-9661-5a4cc92c57ac

	/// Custo de mão de obra (custo unitário × quantidade produzida).
	measure 'Custo Mão de Obra' = SUM(fProducao[Custo Mão de Obra])
		formatString: \R$ #,0
		displayFolder: 05 | Custos
		lineageTag: 045b9382-988e-5880-b6b1-fe64111ab07f

	/// Custo de energia (custo unitário × quantidade produzida).
	measure 'Custo Energia' = SUM(fProducao[Custo Energia])
		formatString: \R$ #,0
		displayFolder: 05 | Custos
		lineageTag: 72a2c29f-bd1f-59cc-a0c1-2446160bd9d9

	/// Custo Total / Produção Real.
	measure 'Custo Unitário' = DIVIDE([Custo Total], [Produção Real])
		formatString: \R$ #,0.00
		displayFolder: 05 | Custos
		lineageTag: 65a705b5-fc00-54a3-bf9f-ef13ba05177a

	/// Custo Total / Produção Boa. Revela deterioração de custo quando há perda de qualidade.
	measure 'Custo por Unidade Boa' = DIVIDE([Custo Total], [Produção Boa])
		formatString: \R$ #,0.00
		displayFolder: 05 | Custos
		lineageTag: 781333cb-d55d-5bae-b0bd-92189509011e

	/// Lead time médio previsto do fornecedor, em dias.
	measure 'Lead Time Previsto (dias)' = AVERAGE(fProducao[Lead Time Previsto])
		formatString: #,0.0
		displayFolder: 06 | Supply Chain
		lineageTag: 34f713ba-56af-5476-8a0f-a58e3a4f2783

	/// Lead time médio real do fornecedor, em dias.
	measure 'Lead Time Real (dias)' = AVERAGE(fProducao[Lead Time Real])
		formatString: #,0.0
		displayFolder: 06 | Supply Chain
		lineageTag: 5791aa25-c63c-5977-ac51-2ee396bdc25c

	/// Lead time real − previsto (média). Positivo = atraso.
	measure 'Desvio Lead Time (dias)' = AVERAGE(fProducao[Atraso Fornecedor Dias])
		formatString: +0.0;-0.0;0.0
		displayFolder: 06 | Supply Chain
		lineageTag: 0d9a98d0-ee0a-5faf-9fdc-9e95494e9df8

	/// Percentual de OPs abastecidas com entrega do fornecedor no prazo (flag da base; tolera até 1 dia de atraso).
	measure 'Fornecedor no Prazo %' = AVERAGE(fProducao[Fornecedor No Prazo])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 | Supply Chain
		lineageTag: 67662f7c-6ca5-5c27-b5b7-768035921af5

	/// Atraso médio, em dias, considerando apenas entregas fora do prazo.
	measure 'Atraso Médio Fornecedor (dias)' = CALCULATE(AVERAGE(fProducao[Atraso Fornecedor Dias]), fProducao[Fornecedor No Prazo] = 0)
		formatString: #,0.0
		displayFolder: 06 | Supply Chain
		lineageTag: 6b6f8a85-11a0-586e-933d-2ff73aae3f6e

	/// Quantidade de matéria-prima recebida nos lotes associados às OPs.
	measure 'Lote MP Recebido' = SUM(fProducao[Lote MP Recebido])
		formatString: #,0
		displayFolder: 06 | Supply Chain
		lineageTag: 7b6b8670-c7fc-5f98-bb6d-2493488d8f69

	/// Quantidade de matéria-prima reprovada no recebimento.
	measure 'Lote MP Reprovado' = SUM(fProducao[Lote MP Reprovado])
		formatString: #,0
		displayFolder: 06 | Supply Chain
		lineageTag: 2747f1fc-d33d-584c-8e9d-6691491ae866

	/// Lote MP Reprovado / Lote MP Recebido.
	measure 'Reprovação MP %' = DIVIDE([Lote MP Reprovado], [Lote MP Recebido])
		formatString: 0.00%
		displayFolder: 06 | Supply Chain
		lineageTag: a83c328b-bfb3-532c-98dd-c103a516d472

	/// Média do estoque final de MP registrado nas OPs. A base traz uma posição por OP (não é razão contínua de estoque), por isso usa-se média.
	measure 'Estoque Final Médio MP' = AVERAGE(fProducao[Estoque Final MP])
		formatString: #,0
		displayFolder: 07 | Estoques
		lineageTag: 1202eec1-5140-5916-8a6b-b25a2799c650

	/// Média do estoque de segurança de MP registrado nas OPs.
	measure 'Estoque Segurança Médio MP' = AVERAGE(fProducao[Estoque Segurança MP])
		formatString: #,0
		displayFolder: 07 | Estoques
		lineageTag: e41c3423-466e-5ca2-8e7a-d38087244f6d

	/// Estoque final médio dividido pelo estoque de segurança médio.
	measure 'Índice Estoque / Segurança' = DIVIDE(SUM(fProducao[Estoque Final MP]), SUM(fProducao[Estoque Segurança MP]))
		formatString: 0.00x
		displayFolder: 07 | Estoques
		lineageTag: 83988bf5-de1f-52f6-9f78-086c01d62dfd

	/// Consumo de matéria-prima nas OPs.
	measure 'Consumo MP' = SUM(fProducao[Consumo MP])
		formatString: #,0
		displayFolder: 07 | Estoques
		lineageTag: d41a11bf-1a85-5b05-a52a-e77b2c31822e

	/// Recebimento de matéria-prima registrado nas OPs.
	measure 'Recebimento MP' = SUM(fProducao[Recebimento MP])
		formatString: #,0
		displayFolder: 07 | Estoques
		lineageTag: b0d82582-5b86-5e29-8a5b-57c35143bfb9

	/// Estoque final médio / consumo médio por OP: quantas OPs equivalentes o estoque cobre.
	measure 'Cobertura (nº de OPs)' = DIVIDE(AVERAGE(fProducao[Estoque Final MP]), AVERAGE(fProducao[Consumo MP]))
		formatString: #,0.0
		displayFolder: 07 | Estoques
		lineageTag: d74cbd8e-bef5-5210-99f6-bbc6cf04661f

	/// Número de OPs com ruptura de estoque de MP.
	measure Rupturas = SUM(fProducao[Ruptura])
		formatString: #,0
		displayFolder: 07 | Estoques
		lineageTag: 6f1c26d6-df3d-59d6-8f85-b8329dea06ed

	/// Rupturas / Nº de OPs.
	measure 'Taxa de Ruptura %' = DIVIDE([Rupturas], [Nº OPs])
		formatString: 0.00%
		displayFolder: 07 | Estoques
		lineageTag: 91986a25-fe43-5b14-8c68-38dacbca63ec

	/// Número de OPs cujo estoque final de MP ficou abaixo do estoque de segurança.
	measure 'OPs Abaixo da Segurança' = SUM(fProducao[Abaixo Segurança])
		formatString: #,0
		displayFolder: 07 | Estoques
		lineageTag: 0e7808c1-81ad-5225-bd6f-c70d08501d9c

	/// Percentual de OPs com estoque final de MP abaixo do estoque de segurança.
	measure 'OPs Abaixo da Segurança %' = DIVIDE([OPs Abaixo da Segurança], [Nº OPs])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 | Estoques
		lineageTag: 85c44ba0-8ef3-5be6-8f8e-9cdd0f0e529f

	/// Classificação de risco de estoque no contexto (ex.: por matéria-prima): CRÍTICO se % de OPs abaixo da segurança ≥ 12% ou taxa de ruptura ≥ 3%; ATENÇÃO se ≥ limite gerencial (10%); EXCESSO se índice estoque/segurança > 4; senão SAUDÁVEL.
	measure 'Status Estoque' =
			VAR _ab = [OPs Abaixo da Segurança %]
			VAR _rp = [Taxa de Ruptura %]
			VAR _ix = [Índice Estoque / Segurança]
			RETURN SWITCH(TRUE(),
			    ISBLANK(_ab), BLANK(),
			    _ab >= 0.12 || _rp >= 0.03, "CRÍTICO",
			    _ab >= [Limite OPs Abaixo Segurança], "ATENÇÃO",
			    _ix > 4, "EXCESSO",
			    "SAUDÁVEL")
		displayFolder: 07 | Estoques
		lineageTag: 12dab5a2-3f0a-55d5-9fa8-a12abd68529f

	/// Número de matérias-primas classificadas como CRÍTICO ou ATENÇÃO.
	measure 'Materiais em Risco' = COUNTROWS(FILTER(VALUES(dMateriaPrima[Matéria-Prima]), [Status Estoque] IN {"CRÍTICO", "ATENÇÃO"})) + 0
		formatString: #,0
		displayFolder: 07 | Estoques
		lineageTag: 6c2d338c-5b0d-563a-8071-3027a84696b1

	/// Score 0–100 do fornecedor = 40% Pontualidade (% no prazo) + 30% Qualidade do lote (1 − reprovação/3%, limitado a 0–1) + 30% Aderência de lead time (1 − desvio médio/5 dias, limitado a 0–1). Pesos são parâmetros gerenciais.
	measure 'Supplier Score' =
			VAR _pont = [Fornecedor no Prazo %]
			VAR _qual = 1 - MIN(1, DIVIDE([Reprovação MP %], 0.03))
			VAR _lead = 1 - MIN(1, MAX(0, DIVIDE([Desvio Lead Time (dias)], 5)))
			RETURN IF(NOT ISBLANK(_pont), ROUND(100 * (0.4 * _pont + 0.3 * _qual + 0.3 * _lead), 0))
		formatString: 0
		displayFolder: 08 | Fornecedores
		lineageTag: 82d94597-fcaa-58f0-9267-a43c60ce638a

	/// Classe do Supplier Score: A (≥ 75), B (≥ 60), C (< 60).
	measure 'Supplier Score Classe' =
			VAR _s = [Supplier Score]
			RETURN SWITCH(TRUE(), ISBLANK(_s), BLANK(), _s >= 75, "A", _s >= 60, "B", "C")
		displayFolder: 08 | Fornecedores
		lineageTag: 6aa3f40e-04e4-5db3-b8bb-bc8be1abc588

	/// Número de fornecedores com pontualidade abaixo da meta.
	measure 'Fornecedores Fora da Meta' = COUNTROWS(FILTER(VALUES(dFornecedor[Fornecedor]), [Fornecedor no Prazo %] < [Meta Fornecedor no Prazo])) + 0
		formatString: #,0
		displayFolder: 08 | Fornecedores
		lineageTag: f2ca6cc4-8428-5d85-a499-4846eecf2e14

	/// Percentual de OPs entregues ao cliente no prazo e na quantidade (flag OTIF da base).
	measure 'OTIF %' = AVERAGE(fProducao[OTIF])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09 | Logística
		lineageTag: e91a556c-a5a1-58bb-a73d-1a9162e2e26f

	/// Número de OPs com atraso de entrega ao cliente (> 0 dias).
	measure 'Entregas Atrasadas' = CALCULATE(COUNTROWS(fProducao), fProducao[Atraso Entrega Dias] > 0) + 0
		formatString: #,0
		displayFolder: 09 | Logística
		lineageTag: ec65b249-f326-5127-ab11-a7e022716856

	/// Entregas atrasadas / Nº de OPs.
	measure 'Entregas Atrasadas %' = DIVIDE([Entregas Atrasadas], [Nº OPs])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09 | Logística
		lineageTag: 87fa18fc-2a49-5fec-aec2-e87a3c471f3e

	/// INFERÊNCIA: OPs sem OTIF e sem atraso de entrega (falha atribuída à quantidade incompleta) / Nº de OPs.
	measure 'Falha In-Full % (inferida)' = DIVIDE(CALCULATE(COUNTROWS(fProducao), fProducao[OTIF] = 0, fProducao[Atraso Entrega Dias] <= 0), [Nº OPs])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09 | Logística
		lineageTag: 66e181f2-a07f-534d-9857-eaa7c70e083a

	/// Atraso médio, em dias, das entregas atrasadas.
	measure 'Atraso Médio Entrega (dias)' = CALCULATE(AVERAGE(fProducao[Atraso Entrega Dias]), fProducao[Atraso Entrega Dias] > 0)
		formatString: #,0.0
		displayFolder: 09 | Logística
		lineageTag: 24d32f18-c380-5c50-8b9f-e5ebad635a25

	/// Prazo médio acordado com o cliente, em dias.
	measure 'Prazo Cliente Médio (dias)' = AVERAGE(fProducao[Prazo Cliente Dias])
		formatString: #,0.0
		displayFolder: 09 | Logística
		lineageTag: 5fb7658d-5f8e-5d7f-89b6-e3f51fedade3

	/// Custo total de frete.
	measure 'Custo Frete' = SUM(fProducao[Custo Frete])
		formatString: \R$ #,0
		displayFolder: 09 | Logística
		lineageTag: 740b0dbd-03c7-5a83-be66-7e493a1235db

	/// Custo de frete / Produção Boa.
	measure 'Frete por Unidade' = DIVIDE([Custo Frete], [Produção Boa])
		formatString: \R$ #,0.00
		displayFolder: 09 | Logística
		lineageTag: 3ed7dba2-57fa-50b2-99f4-8113c554cb2f

	/// Produção real no período imediatamente anterior, de mesma duração. Em branco quando não há histórico completo para comparar.
	measure 'Produção Real PA' =
			VAR _ini = MIN(dCalendario[Data])
			VAR _fim = MAX(dCalendario[Data])
			VAR _dias = DATEDIFF(_ini, _fim, DAY) + 1
			VAR _primeira = CALCULATE(MIN(dCalendario[Data]), REMOVEFILTERS(dCalendario))
			RETURN IF(_ini - _dias >= _primeira, CALCULATE([Produção Real], DATESBETWEEN(dCalendario[Data], _ini - _dias, _ini - 1)))
		formatString: #,0
		displayFolder: 10 | Comparativos
		lineageTag: d0bef5cd-0b35-5594-bd8c-618a2c3ebad9

	/// OEE no período imediatamente anterior, de mesma duração. Em branco quando não há histórico completo para comparar.
	measure 'OEE % PA' =
			VAR _ini = MIN(dCalendario[Data])
			VAR _fim = MAX(dCalendario[Data])
			VAR _dias = DATEDIFF(_ini, _fim, DAY) + 1
			VAR _primeira = CALCULATE(MIN(dCalendario[Data]), REMOVEFILTERS(dCalendario))
			RETURN IF(_ini - _dias >= _primeira, CALCULATE([OEE %], DATESBETWEEN(dCalendario[Data], _ini - _dias, _ini - 1)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10 | Comparativos
		lineageTag: ec3565e7-1af2-5ff6-89c3-d1e853990e32

	/// Variação da produção real versus o período anterior de mesma duração.
	measure 'Produção Real Δ PA %' = VAR _pa = [Produção Real PA] RETURN IF(NOT ISBLANK(_pa), DIVIDE([Produção Real] - _pa, _pa))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10 | Comparativos
		lineageTag: 3202eec1-d780-5c53-9e2a-73b69cc507f2

	/// Variação do OEE em pontos percentuais versus o período anterior de mesma duração.
	measure 'OEE Δ PA p.p.' = VAR _pa = [OEE % PA] RETURN IF(NOT ISBLANK(_pa), ([OEE %] - _pa) * 100)
		formatString: +0.0;-0.0;0.0
		displayFolder: 10 | Comparativos
		lineageTag: cdefc72b-79ce-5890-9b93-3199f04797f0

	/// Produção Real: último mês do contexto versus o mês anterior (variação relativa).
	measure 'Produção Real Δ Mês' =
			VAR _ult = MAX(fProducao[Data])
			VAR _mes = DATE(YEAR(_ult), MONTH(_ult), 1)
			VAR _cur = CALCULATE([Produção Real], dCalendario[Início Mês] = _mes)
			VAR _ant = CALCULATE([Produção Real], REMOVEFILTERS(dCalendario), dCalendario[Início Mês] = EDATE(_mes, -1))
			RETURN IF(NOT ISBLANK(_cur) && NOT ISBLANK(_ant), DIVIDE(_cur - _ant, _ant))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10 | Comparativos
		lineageTag: 0cc7f690-8bb0-5d59-a8c2-bf7bed9308c1

	/// Aderência ao Plano %: último mês do contexto versus o mês anterior (em pontos percentuais).
