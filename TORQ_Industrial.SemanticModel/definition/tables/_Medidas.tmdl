	/// Fundo do heatmap Linha × Turno: desvio do OEE da célula em relação ao OEE da seleção (verde ≥ +1 p.p.; neutro ±1; amarelo até −2,5; vermelho abaixo).
	measure 'Cor Heat OEE' =
			VAR _v = [OEE %]
			VAR _ref = CALCULATE([OEE %], ALLSELECTED(dLinha), ALLSELECTED(dTurno))
			VAR _d = (_v - _ref) * 100
			RETURN SWITCH(TRUE(), ISBLANK(_v), BLANK(), _d >= 1, "#CFEBDD", _d >= -1, "#F3F6F9", _d >= -2.5, "#FBE9B8", "#F5C1BC")
		isHidden
		displayFolder: 15 | Cores (formatação)
		lineageTag: 6ef52362-8df3-5ae2-9785-804d740dbefe

	/// Fundo do heatmap Linha × Causa de defeito: intensidade do CNQ da célula relativa à maior célula da seleção (5 faixas de laranja).
	measure 'Cor Heat Defeito' =
			VAR _v = [CNQ Defeitos]
			VAR _max = MAXX(CROSSJOIN(ALLSELECTED(dLinha[Linha]), ALLSELECTED(dCausaDefeito[Causa Defeito])), [CNQ Defeitos])
			VAR _r = DIVIDE(_v, _max)
			RETURN SWITCH(TRUE(), ISBLANK(_v), BLANK(), _r >= 0.9, "#FF8A3D", _r >= 0.75, "#FFAE78", _r >= 0.6, "#FFCDA8", _r >= 0.45, "#FFE6D3", "#FFFFFF")
		isHidden
		displayFolder: 15 | Cores (formatação)
		lineageTag: 32065cc2-5ff1-5978-835b-800d9d818d85

	/// Sparkline SVG do OEE mensal no contexto (linha + último ponto destacado). Gerado dinamicamente a partir das medidas.
	measure 'Sparkline OEE' =
			VAR _t = FILTER(ADDCOLUMNS(VALUES(dCalendario[AnoMês Num]), "@v", [OEE %]), NOT ISBLANK([@v]))
			VAR _n = COUNTROWS(_t)
			VAR _min = MINX(_t, [@v])
			VAR _max = MAXX(_t, [@v])
			VAR _rng = IF(_max = _min, 1, _max - _min)
			VAR _i = ADDCOLUMNS(_t, "@i", VAR _m = dCalendario[AnoMês Num] RETURN COUNTROWS(FILTER(_t, dCalendario[AnoMês Num] <= _m)))
			VAR _xy = ADDCOLUMNS(_i, "@x", 3 + ([@i] - 1) * DIVIDE(114, _n - 1), "@y", 21 - DIVIDE([@v] - _min, _rng) * 18)
			VAR _pts = CONCATENATEX(_xy, FORMAT([@x], "0.0", "en-US") & "," & FORMAT([@y], "0.0", "en-US"), " ", [@i], ASC)
			VAR _ult = FILTER(_xy, [@i] = _n)
			VAR _cx = FORMAT(MAXX(_ult, [@x]), "0.0", "en-US")
			VAR _cy = FORMAT(MAXX(_ult, [@y]), "0.0", "en-US")
			RETURN IF(_n > 1,
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 24' width='120' height='24'>"
			    & "<polyline fill='none' stroke='%23A7B1BD' stroke-width='1.5' stroke-linejoin='round' points='" & _pts & "'/>"
			    & "<circle cx='" & _cx & "' cy='" & _cy & "' r='2.6' fill='%23FF6A00'/></svg>")
		displayFolder: 16 | SVG
		lineageTag: accc85f1-dafe-55d3-bb81-eeb4566d6324
		dataCategory: ImageUrl

	/// Bullet SVG: barra do OEE contra a meta (traço vertical) em escala de 50% a 100%.
	measure 'Barra OEE vs Meta' =
			VAR _v = [OEE %]
			VAR _w = MAX(0, MIN(1, DIVIDE(_v - 0.5, 0.5))) * 116
			VAR _mx = 2 + MAX(0, MIN(1, DIVIDE([Meta OEE] - 0.5, 0.5))) * 116
			VAR _cor = SUBSTITUTE([Cor OEE], "#", "%23")
			RETURN IF(NOT ISBLANK(_v),
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 24' width='120' height='24'>"
			    & "<rect x='2' y='8' width='116' height='8' rx='4' fill='%23E9EEF3'/>"
			    & "<rect x='2' y='8' width='" & FORMAT(_w, "0.0", "en-US") & "' height='8' rx='4' fill='" & _cor & "'/>"
			    & "<rect x='" & FORMAT(_mx, "0.0", "en-US") & "' y='4' width='2' height='16' fill='%231E2D3D'/></svg>")
		displayFolder: 16 | SVG
		lineageTag: a3591411-5b2e-5814-a094-0844f80bd259
		dataCategory: ImageUrl

	column '_'
		dataType: string
		isHidden
		lineageTag: e1444e3c-87de-5d2b-ad3e-29d07004fad7
		summarizeBy: none
