	/// Alerta 7 (OTIF abaixo da meta): ação sugerida.
	measure 'A7 Ação' =
			VAR _sT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dCliente[Segmento]), "@v", [OTIF %]), NOT ISBLANK([@v])), [@v], ASC)
			VAR _sN = MAXX(_sT, dCliente[Segmento])
			VAR _sV = MAXX(_sT, [@v])
			RETURN "Segmento mais afetado: " & _sN & " (" & FORMAT(_sV, "0.0%", "pt-BR") & "). Revisar promessa de prazo e sequenciamento."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 299857df-7eed-518d-83d4-343f05411061

	/// Alerta 8 (Custo da não qualidade elevado): desvio normalizado 0–1 em relação ao limite; em branco quando o alerta está inativo.
	measure 'A8 Desvio' =
			VAR _lim = [Limite CNQ]
			VAR _v = [CNQ % do Custo]
			RETURN IF(_v > _lim, MIN(1, DIVIDE(DIVIDE(_v - _lim, _lim), 0.5)))
		isHidden
		formatString: 0.00
		displayFolder: 12 | Alertas\Componentes
		lineageTag: c4aa9adc-17a5-50e5-9085-60f093bfd6d3

	/// Alerta 8 (Custo da não qualidade elevado): descrição dinâmica da ocorrência.
	measure 'A8 Texto' =
			VAR _pT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dProduto[Produto]), "@v", [Custo Não Qualidade]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _pN = MAXX(_pT, dProduto[Produto])
			VAR _pV = MAXX(_pT, [@v])
			RETURN "CNQ de " & IF(ABS([Custo Não Qualidade]) >= 1000000, "R$ " & FORMAT(DIVIDE([Custo Não Qualidade], 1000000), "0.00", "pt-BR") & " Mi", "R$ " & FORMAT(DIVIDE([Custo Não Qualidade], 1000), "#,0", "pt-BR") & " mil") & " (" & FORMAT([CNQ % do Custo], "0.00%", "pt-BR") & " do custo). Maior peso: " & _pN & " (" & IF(ABS(_pV) >= 1000000, "R$ " & FORMAT(DIVIDE(_pV, 1000000), "0.00", "pt-BR") & " Mi", "R$ " & FORMAT(DIVIDE(_pV, 1000), "#,0", "pt-BR") & " mil") & ")."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 6166095f-cb58-53a9-9a76-d8e65116033c

	/// Alerta 8 (Custo da não qualidade elevado): ação sugerida.
	measure 'A8 Ação' = "Priorizar o produto de maior CNQ e a causa: " & [Principal Causa Defeito] & "."
		isHidden
		displayFolder: 12 | Alertas\Componentes
		lineageTag: 63fd68e5-72f7-5102-acb6-c2ed6a1d21e7

	/// Índice de prioridade 0–100 do alerta = 100 × Peso de criticidade × (0,4 + 0,6 × Desvio normalizado). Em branco quando o alerta está inativo no contexto filtrado.
	measure 'Alerta Índice' =
			VAR _d = SWITCH(SELECTEDVALUE(Alertas[ID]), 1, [A1 Desvio], 2, [A2 Desvio], 3, [A3 Desvio], 4, [A4 Desvio], 5, [A5 Desvio], 6, [A6 Desvio], 7, [A7 Desvio], 8, [A8 Desvio])
			VAR _peso = SELECTEDVALUE(Alertas[Peso])
			RETURN IF(NOT ISBLANK(_d), ROUND(100 * _peso * (0.4 + 0.6 * _d), 0))
		formatString: 0
		displayFolder: 12 | Alertas
		lineageTag: ded8bcea-8ced-5845-a600-fc4f19604139

	/// Classe de prioridade do alerta: CRÍTICA (≥ 75), ALTA (≥ 55), MÉDIA (≥ 35) ou BAIXA.
	measure 'Alerta Prioridade' =
			VAR _s = [Alerta Índice]
			RETURN SWITCH(TRUE(), ISBLANK(_s), BLANK(), _s >= 75, "CRÍTICA", _s >= 55, "ALTA", _s >= 35, "MÉDIA", "BAIXA")
		displayFolder: 12 | Alertas
		lineageTag: d9d80672-2513-5740-b32d-fe2fd2045b1a

	/// Descrição dinâmica da ocorrência do alerta, sensível aos filtros.
	measure 'Alerta Ocorrência' = IF(NOT ISBLANK([Alerta Índice]), SWITCH(SELECTEDVALUE(Alertas[ID]), 1, [A1 Texto], 2, [A2 Texto], 3, [A3 Texto], 4, [A4 Texto], 5, [A5 Texto], 6, [A6 Texto], 7, [A7 Texto], 8, [A8 Texto]))
		displayFolder: 12 | Alertas
		lineageTag: e1f84dd1-086d-50a0-8237-8d7434bbf31a

	/// Ação sugerida para o alerta.
	measure 'Alerta Ação' = IF(NOT ISBLANK([Alerta Índice]), SWITCH(SELECTEDVALUE(Alertas[ID]), 1, [A1 Ação], 2, [A2 Ação], 3, [A3 Ação], 4, [A4 Ação], 5, [A5 Ação], 6, [A6 Ação], 7, [A7 Ação], 8, [A8 Ação]))
		displayFolder: 12 | Alertas
		lineageTag: bc5ec807-588d-5e53-b6a6-832a19ee3ff3

	/// Quantidade de alertas ativos no contexto filtrado.
	measure 'Alertas Ativos' = COUNTROWS(FILTER(Alertas, NOT ISBLANK([Alerta Índice]))) + 0
		formatString: #,0
		displayFolder: 12 | Alertas
		lineageTag: e5ebdd61-1e12-5b18-9f9b-74c8270c8fc5

	/// Título dinâmico do painel ATENÇÃO AGORA.
	measure 'Alertas Título' =
			VAR _n = [Alertas Ativos]
			VAR _c = COUNTROWS(FILTER(Alertas, [Alerta Prioridade] IN {"CRÍTICA", "ALTA"})) + 0
			RETURN "ATENÇÃO AGORA · " & _n & " alertas ativos, " & _c & " de prioridade alta ou crítica"
		displayFolder: 12 | Alertas
		lineageTag: 51c08e15-2df9-5bbf-973c-44975a8bb7e7

	/// Narrativa executiva dinâmica em quatro blocos (Observação, Diagnóstico, Impacto, Ação). Descreve associações observadas nos dados, sem afirmar causalidade.
	measure 'Insight Texto' =
			VAR _lT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dLinha[Linha]), "@v", [Horas Parada]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _lN = MAXX(_lT, dLinha[Linha])
			VAR _lV = MAXX(_lT, [@v])
			VAR _cT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dCausaParada[Causa Parada]), "@v", [Paradas Pareto h]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _cN = MAXX(_cT, dCausaParada[Causa Parada])
			VAR _cV = MAXX(_cT, [@v])
			VAR _partL = DIVIDE(_lV, [Horas Parada])
			VAR _partC = DIVIDE(_cV, [Horas Parada])
			VAR _pa = [OEE Δ PA p.p.]
			VAR _obs = "Produção de " & FORMAT([Produção Real], "#,0", "pt-BR") & " un., " & FORMAT([Aderência ao Plano %], "0.0%", "pt-BR") & " do plano (gap de " & FORMAT([Gap Produção], "#,0", "pt-BR") & " un.). OEE em " & FORMAT([OEE %], "0.0%", "pt-BR") & ", " & FORMAT(-[OEE Gap Meta p.p.], "0.0", "pt-BR") & " p.p. abaixo da meta"
			    & IF(NOT ISBLANK(_pa), " (" & FORMAT(_pa, "+0.0;-0.0", "pt-BR") & " p.p. vs período anterior)", "") & "."
			VAR _diag = "A maior perda do OEE está em " & [OEE Maior Perda] & ". As OPs com causa " & _cN & " concentram " & FORMAT(_partC, "0%", "pt-BR") & " das horas de parada; a linha com mais horas paradas é " & _lN & " (" & FORMAT(_partL, "0%", "pt-BR") & ")."
			VAR _imp = "As paradas somam " & FORMAT([Horas Parada], "#,0", "pt-BR") & " h, cerca de " & FORMAT([Impacto Downtime un. (est.)], "#,0", "pt-BR") & " un. não produzidas (estimativa). O custo da não qualidade é de " & IF(ABS([Custo Não Qualidade]) >= 1000000, "R$ " & FORMAT(DIVIDE([Custo Não Qualidade], 1000000), "0.00", "pt-BR") & " Mi", "R$ " & FORMAT(DIVIDE([Custo Não Qualidade], 1000), "#,0", "pt-BR") & " mil") & " e o OTIF está em " & FORMAT([OTIF %], "0.0%", "pt-BR") & "."
			VAR _acao = "1º reduzir " & _cN & " na " & _lN & "; 2º tratar fornecedores abaixo da meta de prazo (" & [Fornecedores Fora da Meta] & "); 3º revisar a promessa de entrega ao cliente."
			RETURN SWITCH(SELECTEDVALUE(Insight[Ordem]), 1, _obs, 2, _diag, 3, _imp, 4, _acao)
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: aec2c1f7-5d2a-5efd-acc5-5f808ba5cafe

	/// Resumo da base exibido na capa.
	measure 'Capa Resumo' = "Dados de " & FORMAT(MIN(fProducao[Data]), "mmm/yyyy", "pt-BR") & " a " & FORMAT(MAX(fProducao[Data]), "mmm/yyyy", "pt-BR") & "  ·  " & FORMAT([Nº OPs], "#,0", "pt-BR") & " ordens de produção  ·  " & DISTINCTCOUNT(fProducao[Linha Key]) & " linhas em " & DISTINCTCOUNT(dLinha[Planta]) & " plantas"
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: e5704d6f-27a6-5fa3-adaa-5900d6811be4

	/// Subtítulo dinâmico do bloco de OEE.
	measure 'Título OEE' = "Maior perda: " & [OEE Maior Perda] & "  ·  Meta " & FORMAT([Meta OEE], "0%", "pt-BR") & "  ·  " & [OEE Classificação]
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: 0d8937e4-9842-5240-be3c-b33225a0a7b6

	/// Título narrativo do Pareto de paradas.
	measure 'Título Pareto Paradas' =
			VAR _cT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dCausaParada[Causa Parada]), "@v", [Paradas Pareto h]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _cN = MAXX(_cT, dCausaParada[Causa Parada])
			VAR _cV = MAXX(_cT, [@v])
			RETURN _cN & " lidera as perdas: " & FORMAT(DIVIDE(_cV, [Paradas Pareto h]), "0%", "pt-BR") & " das horas de parada com causa identificada"
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: 24c48c78-4297-58a0-8444-4fe6c9e5311f

	/// Título narrativo do Pareto de defeitos.
	measure 'Título Pareto Defeitos' =
			VAR _cT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dCausaDefeito[Causa Defeito]), "@v", [CNQ Defeitos]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _cN = MAXX(_cT, dCausaDefeito[Causa Defeito])
			VAR _cV = MAXX(_cT, [@v])
			RETURN "Defeito " & _cN & " é o mais caro: " & IF(ABS(_cV) >= 1000000, "R$ " & FORMAT(DIVIDE(_cV, 1000000), "0.00", "pt-BR") & " Mi", "R$ " & FORMAT(DIVIDE(_cV, 1000), "#,0", "pt-BR") & " mil") & " em não qualidade"
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: 326371c0-c70f-5da2-9996-e5bfa67ecd49

	/// Título narrativo do gráfico Produção × Plano.
	measure 'Título Produção x Plano' = "Produção atinge " & FORMAT([Aderência ao Plano %], "0.0%", "pt-BR") & " do plano (gap de " & FORMAT([Gap Produção], "#,0", "pt-BR") & " un.)"
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: 5ac17f21-b2c8-5c65-9206-0867b9ee60ce

	/// Título narrativo do scorecard de fornecedores.
	measure 'Título Fornecedores' =
			VAR _fT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dFornecedor[Fornecedor]), "@v", [Supplier Score]), NOT ISBLANK([@v])), [@v], ASC)
			VAR _fN = MAXX(_fT, dFornecedor[Fornecedor])
			VAR _fV = MAXX(_fT, [@v])
			RETURN "Supplier Scorecard · pior score: " & _fN & " (" & _fV & ")"
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: 0702899f-0a16-5061-a341-f02ab7231e64

	/// Título do tooltip de linha.
	measure 'Título Tooltip Linha' = SELECTEDVALUE(dLinha[Linha], "Seleção atual") & "  ·  principal causa de parada: " & [Principal Causa Parada]
		displayFolder: 13 | Narrativa e Títulos
		lineageTag: 2baa5c08-ccb4-5088-93eb-40870f01594a

	/// Linha de contexto do card Produção: variação do último mês vs mês anterior e referência.
	measure 'KPI Produção Sub' =
			VAR _d = [Produção Real Δ Mês]
			VAR _seta = IF(_d >= 0, "▲ ", "▼ ")
			RETURN IF(ISBLANK(_d), "", _seta & FORMAT(_d, "+0.0%;-0.0%", "pt-BR") & " no último mês  ·  ") & "Plano " & FORMAT([Plano], "#,0", "pt-BR")
