	/// Linha de contexto do card Frete: variação do último mês vs mês anterior e referência.
	measure 'KPI Frete Sub' =
			VAR _d = [Frete por Unidade Δ Mês]
			VAR _seta = IF(_d >= 0, "▲ ", "▼ ")
			RETURN IF(ISBLANK(_d), "", _seta & FORMAT(_d, "+0.0%;-0.0%", "pt-BR") & " no último mês  ·  ") & "Total " & IF(ABS([Custo Frete]) >= 1000000, "R$ " & FORMAT(DIVIDE([Custo Frete], 1000000), "0.00", "pt-BR") & " Mi", "R$ " & FORMAT(DIVIDE([Custo Frete], 1000), "#,0", "pt-BR") & " mil")
		displayFolder: 14 | Cards (contexto)
		lineageTag: 3eb4976c-23fb-593f-95b9-52c85148f7fa

	/// Cor semântica de Aderência: verde na meta, amarelo em atenção, vermelho crítico.
	measure 'Cor Aderência' =
			VAR _v = [Aderência ao Plano %]
			VAR _m = [Meta Aderência]
			RETURN SWITCH(TRUE(), ISBLANK(_v), "#A7B1BD", _v >= _m, "#1E9E6A", _v >= _m - 0.03, "#E0A100", "#D64545")
		isHidden
		displayFolder: 15 | Cores (formatação)
		lineageTag: 81816545-6a28-58e3-8b59-cbc9ccc0ec42

