	/// Alerta 4 (MP abaixo do estoque de segurança): descrição dinâmica da ocorrência.
	measure 'A4 Texto' =
			VAR _xT = TOPN(1, FILTER(ADDCOLUMNS(VALUES(dMateriaPrima[Matéria-Prima]), "@v", [OPs Abaixo da Segurança %]), NOT ISBLANK([@v])), [@v], DESC)
			VAR _xN = MAXX(_xT, dMateriaPrima[Matéria-Prima])
			VAR _xV = MAXX(_xT, [@v])
			VAR _n = CALCULATE([OPs Abaixo da Segurança], dMateriaPrima[Matéria-Prima] = _xN)
			RETURN _xN & ": " & FORMAT(_xV, "0.0%", "pt-BR") & " das OPs (" & FORMAT(_n, "#,0", "pt-BR") & ") com estoque abaixo da segurança."
