	/// Percentual de redução de downtime a simular (0–30%).
	column 'Redução Downtime'
		dataType: double
		formatString: 0%
		lineageTag: dd050e10-9137-5269-a746-8ddd7ec59f09
		summarizeBy: none
		sourceColumn: Redução Downtime

		annotation SummarizationSetBy = Automatic

	partition 'Simulação Downtime' = m
		mode: import
		source =
				let
					Fonte = Table.FromList(List.Transform({0 .. 6}, each _ * 0.05), Splitter.SplitByNothing(), type table [Redução Downtime = number])
