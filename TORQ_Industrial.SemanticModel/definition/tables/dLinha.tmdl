/// Dimensão de linhas de produção. O nome da linha se repete entre plantas, por isso a chave combina planta e linha.
table dLinha
	lineageTag: 0c15c562-77d4-5583-a72f-3e99d99e29fc

	column 'Linha Key'
		dataType: string
		isHidden
		isKey
		lineageTag: 99300212-085c-51d6-a2f4-8bcbfe89e30f
		summarizeBy: none
		sourceColumn: Linha Key

		annotation SummarizationSetBy = Automatic

	/// Planta industrial.
	column Planta
		dataType: string
		lineageTag: ccadc878-2806-557b-a3b3-498a6926e35f
		summarizeBy: none
		sourceColumn: Planta

		annotation SummarizationSetBy = Automatic

	/// Código da linha dentro da planta (repete entre plantas).
	column 'Linha Código'
		dataType: string
		lineageTag: 4e819d86-205a-5912-b421-fac1c4c3dd9c
		summarizeBy: none
		sourceColumn: Linha Código

		annotation SummarizationSetBy = Automatic

	/// Linha de produção identificada pela sigla da planta + código (única).
	column Linha
		dataType: string
		lineageTag: d1d7b84e-0312-51f7-8a57-4497f86c04aa
		summarizeBy: none
		sourceColumn: Linha

		annotation SummarizationSetBy = Automatic

	/// Processo da linha: Montagem, Usinagem, Pintura, Embalagem, Testes.
	column Processo
		dataType: string
		lineageTag: a608101d-2b82-5b51-a078-01876ae9325a
		summarizeBy: none
		sourceColumn: Processo

		annotation SummarizationSetBy = Automatic

	partition dLinha = m
		mode: import
		source =
				let
					Fonte = Table.Distinct(Table.SelectColumns(Base, {"linha_key", "planta", "linha"})),
					Sigla = Table.AddColumn(Fonte, "Linha", each Text.Upper(Text.Start([planta], 3)) & " · " & [linha], type text),
					Processo = Table.AddColumn(Sigla, "Processo", each Text.AfterDelimiter([linha], "-"), type text),
					Renomeadas = Table.RenameColumns(Processo, {{"linha_key", "Linha Key"}, {"planta", "Planta"}, {"linha", "Linha Código"}}),
					Ordenada = Table.Sort(Renomeadas, {{"Linha", Order.Ascending}})
				in
					Ordenada

