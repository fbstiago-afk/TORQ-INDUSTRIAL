	partition dCliente = m
		mode: import
		source =
				let
					Fonte = Table.Distinct(Table.SelectColumns(Base, {"id_cliente", "cliente", "segmento_cliente"})),
					Renomeadas = Table.RenameColumns(Fonte, {{"id_cliente", "ID Cliente"}, {"cliente", "Cliente"}, {"segmento_cliente", "Segmento"}}),
					Ordenada = Table.Sort(Renomeadas, {{"ID Cliente", Order.Ascending}})
