/// Dimensão de turnos.
table dTurno
	lineageTag: 2ef9cb94-e1b0-5fcb-a2bf-3e553715fe19

	/// Turno de produção.
	column Turno
		dataType: string
		isKey
		lineageTag: 2c4fc656-dd60-56ee-b83a-dc6d8c2581c6
		summarizeBy: none
		sourceColumn: Turno
		sortByColumn: 'Turno Ordem'

		annotation SummarizationSetBy = Automatic

	column 'Turno Ordem'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a933dbfe-c99c-5adb-b74d-05723ca99d7e
		summarizeBy: none
		sourceColumn: Turno Ordem

		annotation SummarizationSetBy = Automatic

	partition dTurno = m
		mode: import
		source =
				let
					Fonte = Table.Distinct(Table.SelectColumns(Base, {"turno"})),
					Renomeadas = Table.RenameColumns(Fonte, {{"turno", "Turno"}}),
					Ordem = Table.AddColumn(Renomeadas, "Turno Ordem", each Number.FromText(Text.Start([Turno], 1)), Int64.Type),
					Ordenada = Table.Sort(Ordem, {{"Turno Ordem", Order.Ascending}})
				in
					Ordenada

