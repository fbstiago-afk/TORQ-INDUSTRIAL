model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaProjeto","Base","fProducao","dCalendario","dProduto","dLinha","dTurno","dFornecedor","dMateriaPrima","dCliente","dCausaParada","dCausaDefeito","Alertas","Insight","Ponte","Simulação Downtime","Simulação Scrap","_Medidas"]

ref table _Medidas
ref table fProducao
ref table dCalendario
ref table dProduto
ref table dLinha
ref table dTurno
ref table dFornecedor
ref table dMateriaPrima
ref table dCliente
ref table dCausaParada
ref table dCausaDefeito
ref table Alertas
ref table Insight
ref table Ponte
ref table 'Simulação Downtime'
ref table 'Simulação Scrap'
ref table Indicador
ref table 'Analisar por'

